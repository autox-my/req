    {
      "dot": "amber",
      "title": "Claims no component reaches",
      "items": [
        "REQ-0005: The req tool shall require human ratification before any two claims are merged.",
        "REQ-0006: The req tool shall permit splitting a claim into derived claims without constraint.",
        "REQ-0007: Authoring shall be friction-free.",
        "REQ-0012: The req tool shall need no network access for any claim operation when the deployment is configured offline.",
        "REQ-0013: The req tool shall deliver a non engineer author's edit as a Proposal inside an explicit Working set.",
        "REQ-0014: The req tool shall produce exactly one commit per ratified logical Decision.",
        "REQ-0015: The req tool shall not operate a continuous two-way synchronization bridge between a web database and the requirement files.",
        "REQ-0021: The req tool shall never rewrite a claim or merge two claims automatically.",
        "REQ-0022: The req tool shall serialize each relation in exactly one claim file.",
        "REQ-0023: The decision boundary shall be deliberately high-friction, demanding role, meaning, and evidence there.",
        "REQ-0039: The install script shall refuse a tarball whose hash differs from the pin.",
        "REQ-0041: The req tool shall report an outcome it cannot establish as UNVERIFIABLE rather than as a pass."
      ]
    },
