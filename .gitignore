# Rust build artifacts
/target/
Cargo.lock.bak

# Session scratch (never part of the deliverable tree)
.scratch/

# OS junk: Finder drops .DS_Store into any directory it opens, and it must never be staged.
.DS_Store
Thumbs.db

# Editors
*.swp
.idea/
.vscode/

# Tool state — kept in-repo because $HOME is read-only in this sandbox
.cargo-home/
.npm-cache/
tools/ocr/node_modules/

# Python bytecode: the corpus builders import each other, so running one drops a
# __pycache__/ that is not part of the tree (and blocks `git worktree remove`).
__pycache__/

# Feature worktrees (inside the workspace; see AGENTS.md)
worktrees/
.models/
.tools/

# Never commit a credential. The harness keeps its own outside the repository
# (outside the repository); this is the guard for one dropped in by mistake.
secrets.env
*.env
