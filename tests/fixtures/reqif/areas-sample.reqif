<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC, written by hand for tests/reqif_import.rs (task I-1); not an export of any tool.
     The hierarchy of specification "Main":
       H-0 (Diagnostics)
         H-1 (Démarrage 起動)
           R-1
             R-2
         R-3
         R-5
       R-4
       H-2 (Interfaces)
         R-5
     R-6 sits under no hierarchy node. The objects are listed in an order that differs from the
     hierarchy's (R-3 before R-1), so file order and reading order are two different things. -->
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-1">
      <CREATION-TIME>1999-12-31T23:59:59Z</CREATION-TIME>
      <REQ-IF-TOOL-ID>synthetic, by hand</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <TITLE>Areas sample</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-S" LONG-NAME="String"/>
        <DATATYPE-DEFINITION-XHTML IDENTIFIER="DT-X" LONG-NAME="Xhtml"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="T-REQ" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="AD-TEXT" LONG-NAME="ReqIF.Text"><TYPE><DATATYPE-DEFINITION-XHTML-REF>DT-X</DATATYPE-DEFINITION-XHTML-REF></TYPE></ATTRIBUTE-DEFINITION-XHTML>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-ID" LONG-NAME="ID"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-S</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-OBJECT-TYPE IDENTIFIER="T-HEAD" LONG-NAME="Heading">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-CHAP" LONG-NAME="ReqIF.ChapterName"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-S</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-HID" LONG-NAME="ID"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-S</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="H-0"><TYPE><SPEC-OBJECT-TYPE-REF>T-HEAD</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Diagnostics"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-CHAP</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="D-0"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-HID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="H-1"><TYPE><SPEC-OBJECT-TYPE-REF>T-HEAD</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Démarrage 起動"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-CHAP</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="D-1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-HID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="H-2"><TYPE><SPEC-OBJECT-TYPE-REF>T-HEAD</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Interfaces"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-CHAP</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-3"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-3 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-3"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-1"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-1 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-2"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-2 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-2"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-4"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-4 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-4"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-5"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-5 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-5"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-6"><TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The R-6 shall hold.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="SW-6"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SP-MAIN" LONG-NAME="Main">
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="HN-H-0"><OBJECT><SPEC-OBJECT-REF>H-0</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="HN-H-1"><OBJECT><SPEC-OBJECT-REF>H-1</SPEC-OBJECT-REF></OBJECT>
                  <CHILDREN>
                    <SPEC-HIERARCHY IDENTIFIER="HN-R-1"><OBJECT><SPEC-OBJECT-REF>R-1</SPEC-OBJECT-REF></OBJECT>
                      <CHILDREN>
                        <SPEC-HIERARCHY IDENTIFIER="HN-R-2"><OBJECT><SPEC-OBJECT-REF>R-2</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
                      </CHILDREN>
                    </SPEC-HIERARCHY>
                  </CHILDREN>
                </SPEC-HIERARCHY>
                <SPEC-HIERARCHY IDENTIFIER="HN-R-3"><OBJECT><SPEC-OBJECT-REF>R-3</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
                <SPEC-HIERARCHY IDENTIFIER="HN-R-5-a"><OBJECT><SPEC-OBJECT-REF>R-5</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="HN-R-4"><OBJECT><SPEC-OBJECT-REF>R-4</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="HN-H-2"><OBJECT><SPEC-OBJECT-REF>H-2</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="HN-R-5-b"><OBJECT><SPEC-OBJECT-REF>R-5</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
